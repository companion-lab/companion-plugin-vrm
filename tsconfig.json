{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "typeRoots": ["../../app/node_modules/@types"],
    "paths": {
      "@companion/plugin": ["../../sdk/js/@companion/plugin/index.ts"]
    }
  },
  "include": ["src"]
}
